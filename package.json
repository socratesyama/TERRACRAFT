{
  "name": "terracraft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TERRA CRAFT — 地形が違うだけで世界が変わるシミュレーション",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate:data": "python3 scripts/validate.py",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run validate:data && vite build"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "0.170.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.18.0",
    "fast-check": "3.23.2",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.21.0",
    "vite": "6.0.7",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
